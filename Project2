a = np.random.uniform(0, 10)
r = np.random.uniform(1, 5)
x = np.linspace(a - r, a + r, 200)

def F(x, a):
  if x<=0:
    return 0
  elif x>=a:
    return 1
  else:
    if 0<x<a:
      return x**2/a**2


def f(x, a):
    x = np.array(x)
    np.where((0 < x) and (x < a), 2 * x / (a**2), 0)


def inv_cdf(u, a):
  x = np.sqrt(u) * a
  return x



def sample_from_f(n, a):
  u = np.random.uniform(0, 1, n)
  samples = inv_cdf(u, a)
  return samples

